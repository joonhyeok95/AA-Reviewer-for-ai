# ============================================================
# flowlog 운영 환경값 - .env 로 복사해 채운다 (./gen-secrets.sh 가 비밀값을 자동 생성)
#  - .env 는 커밋하지 않는다 (deploy/.gitignore)
# ============================================================

# 서비스 도메인 (ALB 에 연결한 도메인, https:// 없이)
DOMAIN=church.example.com

# 앱 관리자(admin) 로그인 비밀번호 - Keycloak flowlog realm 의 admin 계정
APP_ADMIN_PASSWORD=

# Keycloak 관리 콘솔(master realm) 관리자 비밀번호 - http://localhost:7000 (SSM 포트 포워딩)
KC_ADMIN_PASSWORD=
# Keycloak DB(PostgreSQL) 비밀번호
KC_DB_PASSWORD=

# OAuth2 client secret (flowlog-bff : 화면 로그인, flowlog-batch : 서버 간 호출)
BFF_CLIENT_SECRET=
BATCH_CLIENT_SECRET=

# 세션 암호화 키 (Base64 32바이트 : openssl rand -base64 32) - 바꾸면 모든 사용자 재로그인
SESSION_ENCRYPTION_KEY=

# H2 파일 DB 비밀번호 - DB 를 처음 만들 때 정해진다 (이전한 DB 는 이전 때 쓴 값과 같아야 함)
H2_PASSWORD=

# 테스트 계정(tx.manager, emp01 …) 유지 여부 - 운영은 false
KEEP_TEST_USERS=false

# H2 백업 보관 일수 (/data/backup), 백업 시각 (Spring cron : 초 분 시 일 월 요일 - 기본 매일 03:30)
H2_BACKUP_KEEP_DAYS=14
# H2_BACKUP_CRON=0 30 3 * * *

# (선택) ALB 사설 IP 대역 정규식 - 기본은 사설 대역 전체 (10.x, 172.16~31.x, 192.168.x)
# TRUSTED_PROXIES=172\.31\.\d+\.\d+
# (선택) EC2 에서 열 포트 - 기본 80
# HTTP_PORT=80
