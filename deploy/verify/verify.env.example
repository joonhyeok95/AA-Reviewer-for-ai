# 로컬 검증 전용 (운영 비밀값 아님) - verify.env 로 복사
#  - APP_ADMIN_PASSWORD 는 E2E 가 쓰는 local realm 의 admin 비밀번호와 같게 (spring-boilerplate/infra/keycloak/realm/flowlog-realm.json)
#  - SESSION_ENCRYPTION_KEY : openssl rand -base64 32
DOMAIN=flowlog.localtest.me
APP_ADMIN_PASSWORD=
KC_ADMIN_PASSWORD=verify-kc-admin
KC_DB_PASSWORD=verify-kc-db
BFF_CLIENT_SECRET=verify-bff-secret-0123456789abcdef
BATCH_CLIENT_SECRET=verify-batch-secret-0123456789abcdef
SESSION_ENCRYPTION_KEY=
H2_PASSWORD=verify-h2
KEEP_TEST_USERS=true
HTTP_PORT=8088
# E2E 가 local realm 의 짧은 테스트 비밀번호를 쓰므로 검증에서는 정책을 걸지 않는다
KC_PASSWORD_POLICY=
