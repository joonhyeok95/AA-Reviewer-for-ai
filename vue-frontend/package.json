{
  "name": "vue-frontend",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Flowlog 화면 (Vue 3) - spring-gateway(9909) 경유로 spring-boilerplate API 사용",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
