<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aa.board.post.mapper.PostQueryMapper">

    <sql id="searchWhere">
        <where>
            <if test="cond.keyword != null and cond.keyword != ''">
                AND (p.title LIKE CONCAT('%', #{cond.keyword}, '%')
                     OR p.content LIKE CONCAT('%', #{cond.keyword}, '%'))
            </if>
            <if test="cond.author != null and cond.author != ''">
                AND p.author = #{cond.author}
            </if>
            <if test="cond.from != null">
                AND p.created_at &gt;= #{cond.from}
            </if>
            <if test="cond.to != null">
                AND p.created_at &lt; DATEADD('DAY', 1, #{cond.to})
            </if>
        </where>
    </sql>

    <select id="search" resultType="com.aa.board.post.dto.PostSummary">
        SELECT p.id, p.title, p.author, p.view_count, p.created_at
          FROM posts p
        <include refid="searchWhere"/>
         ORDER BY p.id DESC
         LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
          FROM posts p
        <include refid="searchWhere"/>
    </select>
</mapper>
